# Copy to .env (git-ignored). The database comes from the universus-db repo:
# `docker compose up -d` there publishes Postgres on localhost:5432.
DATABASE_URL=postgres://universus:change-me@localhost:5432/universus
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# Folder the scraper wrote (the one containing sf62x/, ...). Leave empty if images are hosted elsewhere.
IMAGES_DIR=C:/path/to/webscraping/cards_images
# Where browsers fetch images from. Default: this API's /images route.
IMAGE_BASE_URL=http://localhost:3001/images
